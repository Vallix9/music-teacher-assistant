# Скопируйте этот файл в .env и при необходимости измените значения

# Секретный ключ (обязательно смените в production)
SECRET_KEY=change-me-to-random-string

# База данных.
# SQLite (по умолчанию): sqlite:///instance/music_assistant.db
# MySQL: mysql+pymysql://user:password@localhost:3306/music_assistant
DATABASE_URL=sqlite:///instance/music_assistant.db

# Параметры запуска (waitress)
HOST=127.0.0.1
PORT=5000

# 1 — запуск встроенного сервера Flask с отладкой (только для разработки)
FLASK_DEBUG=0
